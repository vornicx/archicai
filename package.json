{
  "name": "archic-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "node server/contact-api.mjs",
    "build": "tsc -b && vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "gen:pages": "node --import tsx scripts/generate-static-pages.ts && node --import tsx scripts/generate-archic-site-pages.ts && node --import tsx scripts/generate-exploration-pages.ts && node --import tsx scripts/generate-intent-pages.ts && node --import tsx scripts/postprocess-generated-seo.ts && node --import tsx scripts/seo-hardening.ts && node --import tsx scripts/validate-generated-seo.ts",
    "submit:indexnow": "node --import tsx scripts/submit-indexnow.ts",
    "test:server": "node --test server/*.test.mjs",
    "quality:staff": "node scripts/staff-quality-gate.mjs && npm run test:server",
    "quality:gate": "node scripts/quality-gate-v3.mjs && npm run quality:staff"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/space-grotesk": "^5.2.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.12",
    "typescript": "~5.6.2",
    "vite": "^6.0.5"
  }
}
